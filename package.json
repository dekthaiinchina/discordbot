{
  "name": "discordbot",
  "version": "2.0.4-fix",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "npm run build && cross-env NODE_ENV=development node --enable-source-maps dist/index.js",
    "prod": "npm run build && npm start",
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "keywords": [
    "discordbot",
    "discordapp"
  ],
  "author": "dekthaiinchina",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "colors": "^1.4.0",
    "cross-env": "^10.1.0",
    "discord.js": "^14.25.1"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "typescript": "^5.9.3"
  }
}
